# Evolutionary feature selection for linear regression.
# Start with two random nonempty feature masks.
# Each generation creates two offspring by flipping one random bit per parent.
# Evaluate parents and offspring using AIC and retain the two best candidates.
# Finally, apply one greedy bit-flip improvement pass and fit the selected model.
# The seed parameter makes the random search reproducible.
#
# .. code-block:: 
#
#   return: Matrix of regression parameters (the betas) and its size depend on icpt input value:
#           OUTPUT SIZE:   OUTPUT CONTENTS:                HOW TO PREDICT Y FROM X AND B:
#   icpt=0: ncol(X)   x 1  Betas for X only                Y ~ X %*% B[1:ncol(X), 1], or just X %*% B
#   icpt=1: ncol(X)+1 x 1  Betas for X and intercept       Y ~ X %*% B[1:ncol(X), 1] + B[ncol(X)+1, 1]
#   icpt=2: ncol(X)+1 x 2  Col.1: betas for X & intercept  Y ~ X %*% B[1:ncol(X), 1] + B[ncol(X)+1, 1]
#                          Col.2: betas for shifted/rescaled X and intercept
#
# In addition, in the last run of linear regression some statistics are provided in CSV format, one comma-separated
# name-value pair per each line, as follows:
#
# INPUT:
# ------------------------------------------------------------------------------------------
# X        Matrix X of feature vectors
# Y        Single-column Matrix Y of response values
# icpt     Intercept presence, shifting and rescaling the columns of X:
#          0 = no intercept, no shifting, no rescaling;
#          1 = add intercept, but neither shift nor rescale X;
#          2 = add intercept, shift & rescale X columns to mean = 0, variance = 1
# reg      Regularization parameter, 0 for no penalty
# tol      Tolerance threshold to train until achieved
# maxi     Maximum iterations 0 means until tolerance is reached
# verbose  Indicator for verbose debug output
# ------------------------------------------------------------------------------------------
#
# OUTPUT:
# -----------------------------------------------------------------------------------------------
# B     Matrix of regression parameters (the betas) and its size depend on icpt input value.
# S     Matrix of selected features ordered as computed by the algorithm.
# -----------------------------------------------------------------------------------------------

m_steplmevolutionary = function(Matrix[Double] X, Matrix[Double] y, Integer icpt = 0,
  Double reg = 1e-7, Double tol = 1e-7, Integer maxi = 0,
  Boolean verbose = TRUE, Integer generations = 3, Integer seed = 42)
  return(Matrix[Double] B, Matrix[Double] S)
{
   if (generations < 1) {
        stop("generations must be at least 1.");
   }
  if( icpt!=0 & icpt!=1 & icpt!=2 )
    stop("Invalid steplm invocation with icpt="+icpt+" (valid values: 0,1,2).");



  if(verbose)
    print("BEGIN EVOLUTIONARY FEATURE SELECTION");
  X_orig = X;
  n = nrow(X_orig);
  m_orig = ncol(X_orig);



  if (icpt == 1 | icpt == 2) {
    beta = mean(y);
    AIC_best_orig = 2 + n * log(sum((beta - y) ^ 2) / n);
  } else {
    beta = 0.0;
    AIC_best_orig = n * log(sum(y ^ 2) / n);
  }
  if(verbose)
    print("Best AIC without any features: " + AIC_best_orig);
  boa_ncol = ncol(X_orig) + as.integer(icpt!=0);

            num_features = ncol(X_orig);

            # Create two random feature masks.
            initial_draws = rand(
              rows=2, cols=num_features, min=0, max=1,
              sparsity=1.0, seed=seed);

            population = (initial_draws >= 0.5);

            # Ensure that each candidate contains at least one feature.
            for (candidate in 1:2) {
              if (sum(population[candidate, ]) == 0) {
                population[candidate, 1] = 1;
              }
            }

        best_candidate_aic = Inf;

        mutation_draws = rand(
          rows=generations, cols=2, min=0, max=1,
          sparsity=1.0, seed=seed);

        feature_positions = t(seq(1, num_features, 1));

        for (generation in 1:generations) {
           if (verbose) {
              print("Generation " + generation);
           }


          bit_1 = min(num_features, 1 + as.integer(floor(
            as.scalar(mutation_draws[generation, 1]) * num_features)));

          bit_2 = min(num_features, 1 + as.integer(floor(
            as.scalar(mutation_draws[generation, 2]) * num_features)));

          child_1 = abs(population[1, ] - (feature_positions == bit_1));
          child_2 = abs(population[2, ] - (feature_positions == bit_2));

          candidates = rbind(rbind(population, child_1), child_2);

          best_candidate = 1;
          best_candidate_aic = Inf;
          candidate_scores = matrix(0, rows=1, cols=nrow(candidates));

          for (candidate in 1:nrow(candidates)) {
            mask = candidates[candidate, ];
            aic_candidate = Inf;

            if (sum(mask) > 0) {
              X_candidate = removeEmpty(target=X_orig, margin="cols", select=mask);
              [aic_candidate, beta_candidate] = linear_regression(
                X_candidate, y, icpt, reg, tol, maxi, verbose);
            }

            candidate_scores[1, candidate] = aic_candidate;
            if (aic_candidate < best_candidate_aic) {
              best_candidate_aic = aic_candidate;
              best_candidate = candidate;
            }

            if (verbose) {
              print("Candidate " + candidate + ": AIC = " + aic_candidate);
            }
          }

          remaining_scores = candidate_scores;
          remaining_scores[1, best_candidate] = Inf;
          second_candidate = as.scalar(rowIndexMin(remaining_scores));

          next_population = rbind(candidates[best_candidate, ],
                                  candidates[second_candidate, ]);
          if (verbose) {
                print("Selected for next generation: " + best_candidate + ", " + second_candidate);
          }

          population = next_population;
        }

        best_mask = population[1, ];
        if (verbose) {
                print("Best AIC after " + generations + " generations: " + best_candidate_aic);
            }

        for (feature in 1:ncol(X_orig)) {
          mutated_mask = abs(best_mask - (feature_positions == feature));

          if (sum(mutated_mask) > 0) {
            X_mutated = removeEmpty(target=X_orig, margin="cols", select=mutated_mask);
            [aic_mutated, beta_mutated] = linear_regression(
              X_mutated, y, icpt, reg, tol, maxi, verbose);

            if (aic_mutated < best_candidate_aic) {
              best_mask = mutated_mask;
              best_candidate_aic = aic_mutated;
              if (verbose) {
                    print("Accepted flip at feature " + feature + ": AIC = " + aic_mutated);
              }
            }
          }
        }

        if (verbose) {
                    print("Best AIC after mutation pass: " + best_candidate_aic);
                }

        # Build the list of selected feature indices explicitly.
        selected_count = as.integer(sum(best_mask));
        evolutionary_S = matrix(0, rows=1, cols=selected_count);

        position = 1;
        for (feature in 1:num_features) {
          if (as.scalar(best_mask[1, feature]) == 1) {
            evolutionary_S[1, position] = feature;
            position = position + 1;
          }
        }

        if (verbose) {
                print("Evolutionary selected features:");
                print(evolutionary_S);
        }


  # Fit the final model using the selected features.

     X_final = removeEmpty(target=X_orig, margin="cols", select=best_mask);
     [final_aic, final_beta] = linear_regression(
       X_final, y, icpt, reg, tol, maxi, verbose);

     S = evolutionary_S;
     if (icpt != 0) {
       S = cbind(S, matrix(boa_ncol, 1, 1));
     }

     B = reorder_matrix(boa_ncol, final_beta, S);
 }

# Computes linear regression using lm and outputs AIC.
linear_regression = function(Matrix[Double] X, Matrix[Double] y, Integer icpt,
  Double reg, Double tol, Integer maxi, Boolean verbose)
  return(Double AIC, Matrix[Double] beta)
{
  # BEGIN THE DIRECT SOLVE ALGORITHM (EXTERNAL CALL)
  beta = lm(X = X, y = y, icpt = icpt, reg=reg, tol=tol, maxi=maxi, verbose=FALSE);

  # PREPARE X for SCORING
  if( icpt != 0 )
    X = cbind(X, matrix(1,nrow(X),1))

  # COMPUTE AIC
  n = nrow(X);
  y_residual = y - X %*% beta;
  ss_res = sum(y_residual ^ 2);
  AIC = (2 * ncol(X)) + n * log(ss_res / n);
}

reorder_matrix = function(
  double ncolX, # number of column in X, inlcuding the intercept column
  matrix[double] B, # beta
  matrix[double] S # Selected
) return(matrix[double] Y) {
  # This function assumes that B and S have same number of elements.
  # if the intercept is included in the model, all inputs should be adjusted
  # appropriately before calling this function.
  S = t(S);
  num_empty_B = ncolX - nrow(B);
  if (num_empty_B < 0) {
    stop("Error: unable to re-order the matrix. Reason: B more than matrix X");
  }
  if (num_empty_B > 0) {
    pad_zeros = matrix(0, num_empty_B, 1);
    B = rbind(B, pad_zeros);
    S = rbind(S, pad_zeros);
  }
  # since the table won't accept zeros as index we hack it.
  S0 = replace(target = S, pattern = 0, replacement = ncolX + 1);
  seqS = seq(1, nrow(S0));
  P = table(seqS, S0, ncolX, ncolX);
  Y = t(P) %*% B;
}


